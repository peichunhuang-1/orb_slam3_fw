{
  "name": "orb_slam3_fw",
  // Same container on a Raspberry Pi 5 and on macOS (Docker Desktop, Apple Silicon); compose.yaml + detect_gpu.sh
  // pass /dev/dri in only where the host has it.
  "initializeCommand": "sh .devcontainer/detect_gpu.sh",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspaces/orb_slam3_fw",
  "remoteUser": "fw",
  "postStartCommand": "bash .devcontainer/gpu_access.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "/usr/local/share/fw/fw-editor.vsix",
        "/usr/local/share/fw/fw-viewer.vsix",
        "anthropic.claude-code"
      ]
    }
  }
}
