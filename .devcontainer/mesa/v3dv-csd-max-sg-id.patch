diff --git a/src/broadcom/vulkan/v3dv_cmd_buffer.c b/src/broadcom/vulkan/v3dv_cmd_buffer.c
index 56643df63..69b20c489 100644
--- a/src/broadcom/vulkan/v3dv_cmd_buffer.c
+++ b/src/broadcom/vulkan/v3dv_cmd_buffer.c
@@ -4305,6 +4305,20 @@ cmd_buffer_create_csd_job(struct v3dv_cmd_buffer *cmd_buffer,
    submit->cfg[3] |= (wgs_per_sg & 0xf) << V3D_CSD_CFG3_WGS_PER_SG_SHIFT;
    submit->cfg[3] |= (batches_per_sg - 1) << V3D_CSD_CFG3_BATCHES_PER_SG_M1_SHIFT;
    submit->cfg[3] |= (wg_size & 0xff) << V3D_CSD_CFG3_WG_SIZE_SHIFT;
+   /* orb-slam3 test patch: V3DV_CSD_MAX_SG_ID sets the CSD "maximum supergroup ID" field (6 bits),
+    * which upstream leaves at 0, to see whether it limits how many supergroups run concurrently.
+    */
+   {
+      static int max_sg_id = -2;
+      if (max_sg_id == -2) {
+         const char *e = getenv("V3DV_CSD_MAX_SG_ID");
+         max_sg_id = e ? atoi(e) : -1;
+         if (max_sg_id >= 0)
+            fprintf(stderr, "v3dv test patch: CSD MAX_SG_ID = %d\n", max_sg_id & 0x3f);
+      }
+      if (max_sg_id >= 0)
+         submit->cfg[3] |= (uint32_t)(max_sg_id & 0x3f) << V3D_CSD_CFG3_MAX_SG_ID_SHIFT;
+   }
    if (wg_size_out)
       *wg_size_out = wg_size;
 
