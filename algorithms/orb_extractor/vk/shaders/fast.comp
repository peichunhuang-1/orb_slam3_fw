#version 450
#extension GL_GOOGLE_include_directive : require
// Generated by tools/gen_shaders.py - do not edit by hand.
layout(local_size_x = 16, local_size_y = 8) in;
#include "common.glsl"

// FAST-9 pre-test for 4 horizontally adjacent pixels per thread: 5 aligned loads decide
// for all 4 pixels whether two adjacent compass points are both brighter or both darker.
// Blocks with a passing pixel go to fastCand[] for the full test (fast_full.comp).
// Requires border >= 11.

// Packed compass test for 2 pixels (16-bit lanes): bit 15 / bit 31 set if the pixel passes.
uint compass2(uint c, uint b, uint r, uint t, uint l, uint t1) {
    const uint HI = 0x80008000u;
    uint ct = c + t1;
    uint bb = ((b | HI) - ct) & HI, br = ((r | HI) - ct) & HI;   // brighter than c + thr
    uint bt = ((t | HI) - ct) & HI, bl = ((l | HI) - ct) & HI;
    uint ch = c | HI;
    uint db = (ch - (b + t1)) & HI, dr = (ch - (r + t1)) & HI;    // darker than c - thr
    uint dt = (ch - (t + t1)) & HI, dl = (ch - (l + t1)) & HI;
    // compass order bottom, right, top, left: a 9-arc covers two adjacent ones
    return (bb & br) | (br & bt) | (bt & bl) | (bl & bb) | (db & dr) | (dr & dt) | (dt & dl) | (dl & db);
}

void main() {
    int W = pc.w, H = pc.h, OFF = pc.off, STR = pc.stride;   // current level (per-level dispatch)
    int x4 = int(gl_GlobalInvocationID.x) * 4;
    int y  = int(gl_GlobalInvocationID.y);
    if (y < pc.border || y >= H - pc.border) return;
    if (x4 + 3 < pc.border || x4 >= W - pc.border) return;
    int ws = STR >> 2, wy = (OFF + y * STR + x4) >> 2;   // uint holding columns x4 .. x4+3 of row y
    uint w3_0 = pyr[wy - 1], w3_1 = pyr[wy], w3_2 = pyr[wy + 1];  // row y, columns x4-4 .. x4+7
    uint w0_1 = pyr[wy - 3 * ws], w6_1 = pyr[wy + 3 * ws];        // rows y-3 / y+3, columns x4 .. x4+3
    uint rgt = (w3_1 >> 24) | (w3_2 << 8);   // column +3 of each pixel
    uint lft = (w3_0 >> 8) | (w3_1 << 24);   // column -3 of each pixel
    const uint M = 0x00FF00FFu;
    uint t1 = uint(pc.fastThr + 1) * 0x00010001u;
    uint pe = compass2(w3_1 & M, w6_1 & M, rgt & M, w0_1 & M, lft & M, t1);                  // pixels 0, 2
    uint po = compass2((w3_1 >> 8) & M, (w6_1 >> 8) & M, (rgt >> 8) & M, (w0_1 >> 8) & M, (lft >> 8) & M, t1);  // 1, 3
    uint pass = ((pe >> 15) & 1u) | ((po >> 14) & 2u) | ((pe >> 29) & 4u) | ((po >> 28) & 8u);  // bit j: pixel x4+j
    int lo = pc.border - x4, hi = W - pc.border - x4;   // pixels j in [lo, hi) are inside the border
    pass &= (lo <= 0 ? 15u : (15u << lo) & 15u) & (hi >= 4 ? 15u : (1u << hi) - 1u);
    if (pass == 0u) return;
    uint i = atomicAdd(fastCandCount, 1u);
    if (i < uint(pc.maxCorners)) fastCand[i] = uint(x4 >> 2) | (uint(y) << 11) | (uint(pc.level) << 24) | (pass << 28);
    else atomicMax(cornerOverflow, 1u);
}
