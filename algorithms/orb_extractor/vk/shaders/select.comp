#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "common.glsl"

// Per-level selection, part 1: keypoints in a stronger fine bin than the level's boundary bin
// are kept; keypoints in the boundary bin go to the tie list for select_tie.comp.
// With distribute, keypoints below the level's boundary rank are kept, those above it dropped,
// and the bins decide only among the keypoints of the boundary rank.
void main() {
    if (aborted()) return;   // abnormal frame (common.glsl)
    uint n = min(kpCount, uint(pc.maxKp));
    for (uint i = gl_GlobalInvocationID.x; i < n; i += gridStride()) {
        int l = kps[i].level;
        if (pc.distribute != 0) {
            ivec2 r = rthr[l];
            int rk = kps[i].rank;
            if (r.x < 0 || rk < r.x) {
                kps[i].selected = 1;
                selIdx[atomicAdd(selCount, 1u)] = i;
                continue;
            }
            if (rk > r.x) continue;
        }
        ivec2 t = thr[l];
        int bin = int(fineBin(kps[i].response));
        if (t.x < 0 || bin > t.x) {
            kps[i].selected = 1;
            selIdx[atomicAdd(selCount, 1u)] = i;
        } else if (bin == t.x) {
            selIdx[uint(pc.selCap) + atomicAdd(tieCount, 1u)] = i;
        }
    }
}
