#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
#include "common.glsl"

// Per-cell FAST thresholds (pc.fastLo > 0), between FAST pass 1 and 2: mark every grid cell
// that got a corner of the high threshold, so pass 2 (low threshold) skips it. All writers
// store the same value, so no atomic. Also records how many corners pass 1 found.
void main() {
    if (aborted()) return;   // abnormal frame (common.glsl)
    uint n = min(cornerCount, uint(pc.maxCorners));
    if (gl_GlobalInvocationID.x == 0u) strongCornerCount = n;
    uint C3 = 3u * uint(pc.gridCells);
    for (uint i = gl_GlobalInvocationID.x; i < n; i += gridStride()) {
        uint e = corners[i];
        int x = int(e & 0x1FFFu), y = int((e >> 13) & 0x1FFFu), l = int(e >> 26);
        grid[C3 + uint(cellOf(x, y, l))] = 1u;
    }
}
